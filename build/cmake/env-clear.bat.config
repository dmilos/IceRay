@rem windows cmd


@setx ICERAY_ROOT ""
@set  ICERAY_ROOT=
reg delete "HKCU\Environment" /v ICERAY_ROOT /f

@setx ICERAY_INSTALL      ""
@reg delete "HKCU\Environment" /v ICERAY_INSTALL /f

@setx ICERAY_INCLUDEDIR   ""
@reg delete "HKCU\Environment" /v ICERAY_INCLUDEDIR /f

@setx ICERAY_SCRIPTDIR    ""
@reg delete "HKCU\Environment" /v ICERAY_SCRIPTDIR /f

@setx ICERAY_RUNTIME      ""
@reg delete "HKCU\Environment" /v ICERAY_RUNTIME /f


@setx ICERAY_PYTONPATH    ""
@reg delete "HKCU\Environment" /v ICERAY_PYTONPATH /f



@echo ICERAY_ROOT:         %ICERAY_ROOT%
@echo ICERAY_INSTALL:      %ICERAY_INSTALL%
@echo ICERAY_INCLUDEDIR:   %ICERAY_INCLUDEDIR%
@echo ICERAY_SCRIPTDIR:    %ICERAY_SCRIPTDIR%
@echo ICERAY_RUNTIME:      %ICERAY_RUNTIME%
@echo ICERAY_PYTONPATH:    %ICERAY_PYTONPATH%
@echo PYTHONPATH:          %PYTHONPATH%

pause
