#!/cmake Solution configuration

#include( "../config.cmake" )


set( COMPONENT_NAME_BARE     "IceRayCoreLib"  )


set( COMPONENT_VERSION_MAJOR       1  )
set( COMPONENT_VERSION_MINOR       0  )
set( COMPONENT_VERSION_REVISION    0  )
set( COMPONENT_VERSION_BUILD       0  )

set( COMPONENT_VERSION__FINAL   ${SOLUTION_VERSION_MAJOR}.${SOLUTION_VERSION_MINOR}.${SOLUTION_VERSION_REVISION}.${SOLUTION_VERSION_BUILD} )

set( COMPONENT_DECORATION_PREFIX  "" )

set( COMPONENT_DECORATION_POSTFIX  "" )
set( COMPONENT_DECORATION_POSTFIX  "${COMPONENT_DECORATION_POSTFIX}-${COMPONENT_VERSION__FINAL}" )
if( MSVC )
    if(CMAKE_CXX_COMPILER_ID MATCHES "Clang")
        set( COMPONENT_DECORATION_POSTFIX  "${COMPONENT_DECORATION_POSTFIX}-${CMAKE_CXX_COMPILER_ID}" )
        set( COMPONENT_DECORATION_POSTFIX  "${COMPONENT_DECORATION_POSTFIX}-${CMAKE_SYSTEM_NAME}" )
        set( COMPONENT_DECORATION_POSTFIX  "${COMPONENT_DECORATION_POSTFIX}-${CMAKE_SYSTEM_PROCESSOR}" )
    endif()
endif()
set( COMPONENT_DECORATION_POSTFIX  "${COMPONENT_DECORATION_POSTFIX}$<$<CONFIG:Debug>:-d>" )

set( COMPONENT_NAME_OUTPUT     ${COMPONENT_DECORATION_PREFIX}${COMPONENT_NAME_BARE}${COMPONENT_DECORATION_POSTFIX} )
set( COMPONENT_NAME_FINAL      ${COMPONENT_DECORATION_PREFIX}${COMPONENT_NAME_BARE}${COMPONENT_DECORATION_POSTFIX} )
