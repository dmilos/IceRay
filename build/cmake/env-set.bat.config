@rem windows cmd


@set  ICERAY_ROOT="${SOLUTION_ROOTDIR}"
@set  ICERAY_ROOT=%ICERAY_ROOT:/=\%
@setx ICERAY_ROOT %ICERAY_ROOT%

@set  ICERAY_INSTALL=%ICERAY_ROOT%\install
@set  ICERAY_INSTALL=%ICERAY_INSTALL:/=\%
@setx ICERAY_INSTALL %ICERAY_INSTALL%

@set  ICERAY_INCLUDEDIR=%ICERAY_INSTALL%\include\${SOLUTION_NAME}
@set  ICERAY_INCLUDEDIR=%ICERAY_INCLUDEDIR:/=\%
@setx ICERAY_INCLUDEDIR %ICERAY_INCLUDEDIR%

@set  ICERAY_SCRIPTDIR=%ICERAY_INSTALL%\script\${SOLUTION_NAME}
@set  ICERAY_SCRIPTDIR=%ICERAY_SCRIPTDIR:/=\%
@setx ICERAY_SCRIPTDIR %ICERAY_SCRIPTDIR%"

@set  ICERAY_RUNTIME="%ICERAY_INSTALL%\bin\@SOLUTION_NAME@"
@set  ICERAY_RUNTIME=%ICERAY_RUNTIME:/=\%
@setx ICERAY_RUNTIME %ICERAY_RUNTIME%


@set  ICERAY_PYTONPATH=%ICERAY_ROOT%\src;%ICERAY_ROOT%\example
@set  ICERAY_PYTONPATH=%ICERAY_PYTONPATH:/=\%
@setx ICERAY_PYTONPATH %ICERAY_PYTONPATH%


@rem TODO make it with check. otherwise it will grow
@rem set PYTHONPATH %PYTHONPATH%;%ICERAY_PYTONPATH%

call ./env-check.bat
pause

