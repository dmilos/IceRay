@rem windows cmd

@echo ---------- Get by CMAKE from $ENV{...}

@echo "ICERAY_ROOT:         " $ENV{ICERAY_ROOT}
@echo "ICERAY_INSTALL:      " $ENV{ICERAY_INSTALL}
@echo "ICERAY_INCLUDEDIR:   " $ENV{ICERAY_INCLUDEDIR}
@echo "ICERAY_SCRIPTDIR:    " $ENV{ICERAY_SCRIPTDIR}
@echo "ICERAY_RUNTIMEDIR:   " $ENV{ICERAY_RUNTIMEDIR}
@echo "ICERAY_PYTONPATH:    " $ENV{ICERAY_PYTONPATH}
@echo "PYTHONPATH:          " $ENV{PYTHONPATH}


@echo ---------- Direct invoke of set

@echo ICERAY_ROOT:          %ICERAY_ROOT%
@echo ICERAY_INSTALL:       %ICERAY_INSTALL%
@echo ICERAY_INCLUDEDIR:    %ICERAY_INCLUDEDIR%
@echo ICERAY_SCRIPTDIR:     %ICERAY_SCRIPTDIR%
@echo ICERAY_RUNTIMEDIR:    %ICERAY_RUNTIMEDIR%
@echo ICERAY_PYTONPATH:     %ICERAY_PYTONPATH%
@echo PYTHONPATH:           %PYTHONPATH%


@echo ---------- List All with prefix ICERAY from environment
@set ICERAY



pause