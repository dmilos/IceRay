#!/bin/bash

export  ICERAY_ROOT=`readlink -f ${SOLUTION_ROOTDIR}`
export  ICERAY_INSTALL=$ICERAY_ROOT/install
export  ICERAY_INCLUDEDIR=$ICERAY_INSTALL/include/${SOLUTION_NAME}
export  ICERAY_SCRIPTDIR=$ICERAY_INSTALL/script/${SOLUTION_NAME}
export  ICERAY_RUNTIME=$ICERAY_INSTALL/bin/@SOLUTION_NAME@
export  ICERAY_PYTONPATH=$ICERAY_ROOT/src:$ICERAY_ROOT/example

#TODO make it with check. otherwise it will grow
# export  PYTHONPATH=%PYTHONPATH%:%ICERAY_PYTONPATH%

source ./env-check.sh

